{ lib, fetchurl, stdenvNoCC, libarchive, patch }:

let
  # Generated by nix/sysroot-lock.py from nix/sysroot.json.
  lock = lib.importJSON ./sysroot.lock.json;
  target = "SailfishOS-${lock.release}-${lock.arch}";

  rpms = map (pkg: fetchurl { inherit (pkg) url sha256; }) lock.packages;
in
stdenvNoCC.mkDerivation {
  name = "sailfish-sdk-sysroot-${target}";
  nativeBuildInputs = [ libarchive patch ];
  buildCommand = ''
    set -euo pipefail
    mkdir -p "$out"

    # Extract each package directly: RPM payloads store a hard-linked file's
    # data only with its last link, which re-archiving them loses. Keep
    # directories writable so later packages can extract into them.
    for rpm in ${lib.concatStringsSep " " rpms}; do
      bsdtar -xf "$rpm" -C "$out" --no-same-owner
      find "$out" -type d ! -perm -u+w -exec chmod u+w {} +
    done

    chmod -R u+w "$out"

    # Replace absolute library references with just the library names
    while IFS= read -r -d "" script; do
      if grep -q -a -m 1 'GNU ld script' "$script"; then
        sed -i \
          -e 's|/usr/lib64/||g' \
          -e 's|/usr/lib/||g' \
          -e 's|/lib64/||g' \
          -e 's|/lib/||g' \
          "$script"
      fi
    done < <(find "$out/usr/lib64" "$out/lib64" "$out/usr/lib" "$out/lib" -name '*.so' -type f -print0 2>/dev/null)

    # Stop clang complaining?
    patch -d "$out" -p1 -i ${./qtypetraits-clang.patch}

    # cxx-qt connects signals to move-only lambdas, which Qt < 5.10 cannot store
    patch -d "$out" -p1 -i ${./qobject-move-only-functors.patch}

    # Find the libc version, we'll pass this to cargo zigbuild later
    libc="$(find "$out" \( -path '*/lib/libc.so.6' -o -path '*/lib64/libc.so.6' \) -print -quit)"
    version="$(grep -a -o -h 'GLIBC_[0-9]\+\.[0-9]\+' "$libc" | sed 's/GLIBC_//' | sort -Vu | tail -1)"
    printf '%s\n' "$version" > "$out/glibc-version"

    find "$out" -type d -exec chmod a+rx {} +
    find "$out" -type f -exec chmod a+r {} +
  '';
}
